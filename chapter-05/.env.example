# Copy this file to .env and fill in the values. Never commit .env.
GEMINI_API_KEY=
# Optional settings (defaults shown)
GEMINI_MODEL=gemini-3.1-flash-lite
LOG_LEVEL=INFO
REQUEST_DELAY_SECONDS=0
# Prices in USD per 1 million tokens: copy them from Google's pricing page.
# While these are 0 the log will show cost_usd=0.000000.
PRICE_INPUT_PER_MILLION=0
PRICE_OUTPUT_PER_MILLION=0